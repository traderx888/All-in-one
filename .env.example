# Telegram Bot Configuration
# 1. Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL=300

# Oil price keywords to monitor (comma-separated)
OIL_KEYWORDS=oil,crude,brent,wti,petroleum,opec

# Minimum price change (%) to trigger an alert (default: 5)
PRICE_CHANGE_THRESHOLD=5
