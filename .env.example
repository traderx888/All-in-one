# ==============================================
# Content Distribution Workflow - Configuration
# ==============================================
# Copy this file to .env and fill in your values

# --- Notion ---
NOTION_API_KEY=your_notion_integration_token
NOTION_DATABASE_ID=your_database_id
# (Optional) Page IDs to sample your writing style from.
# Comma-separated list of page IDs, or leave empty to auto-detect from database.
NOTION_STYLE_PAGE_IDS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_channel_or_chat_id

# --- Patreon (optional – see README for setup) ---
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=

# --- YouTube (optional – see README for setup) ---
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_CHANNEL_ID=

# --- OpenAI (used for summarisation) ---
# You can also use any OpenAI-compatible endpoint (e.g. local LLM)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
